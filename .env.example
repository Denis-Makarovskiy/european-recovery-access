# Lead delivery integration (choose one or more; see app/api/lead/route.ts)
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
ADMISSIONS_EMAIL=
# Sender for Resend delivery. Must be on a domain verified in Resend,
# e.g. "European Recovery Access <admissions@yourdomain.com>".
# Unset falls back to Resend's sandbox sender, which only reaches the
# Resend account owner — set this before launch.
LEAD_FROM_EMAIL=

# Public runtime values (safe to expose to the client)
NEXT_PUBLIC_ADMISSIONS_PHONE=
NEXT_PUBLIC_SCHEDULER_URL=
NEXT_PUBLIC_GA_ID=
