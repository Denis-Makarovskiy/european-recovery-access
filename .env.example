# Lead delivery is no longer configured here. The site is a static export
# (see next.config.ts) with no server-side route handler, so leads are
# delivered by the Cloudflare Worker in worker/ instead — configure webhook
# / email delivery secrets there (see worker/'s own env/config, not this file).

# Where the client-side forms (components/sections/Hero.tsx,
# components/sections/Assessment.tsx) POST leads to. Point this at the
# deployed Worker's URL in production, or at a local Worker for development,
# e.g. NEXT_PUBLIC_LEAD_ENDPOINT=http://localhost:8787
NEXT_PUBLIC_LEAD_ENDPOINT=

# Set only for GitHub Pages *project* pages (https://<user>.github.io/<repo>/),
# to "/<repo>" (leading slash, no trailing slash) so basePath/assetPrefix
# route correctly. Leave empty for a custom domain or a user/organization
# pages repo served from the origin root.
NEXT_PUBLIC_BASE_PATH=

# Public runtime values (safe to expose to the client)
NEXT_PUBLIC_ADMISSIONS_PHONE=
NEXT_PUBLIC_SCHEDULER_URL=
NEXT_PUBLIC_GA_ID=
