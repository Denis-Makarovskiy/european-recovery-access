# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prospect data stays local: business contacts of third parties must not
# be published in a public repository.
drafts/outreach/prospects-seed.csv
drafts/outreach/prospect-sources.md
drafts/outreach/prospects-*.csv

# The lead Worker now lives in its own PRIVATE repository:
# github.com/Denis-Makarovskiy/era-lead-worker
# Publishing its source next to a public static site exposed the honeypot
# field name and the rate-limit parameters. Do not re-add it here.
worker/
